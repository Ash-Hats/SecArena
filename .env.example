# SecArena - Environment Variables Configuration Example
# Copy this file to .env for local development

# Application Configuration
APP_NAME="SecArena"
ENVIRONMENT="development"
DEBUG=True
FRONTEND_URL="http://localhost:5173"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://secarena_user:secarena_password@localhost:5432/secarena_db"

# Security Configuration
# Required in production: generate unique values, for example with `openssl rand -hex 32`.
SECRET_KEY="<set-a-unique-secret-key>"
JWT_SECRET_KEY="<set-a-unique-jwt-secret-key>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
