# SecArena - Environment Variables Configuration Example
# Copy this file to .env for local development

# Application Configuration
APP_NAME="SecArena"
ENVIRONMENT="development"
DEBUG=True
FRONTEND_URL="http://localhost:5173"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://secarena_user:secarena_password@localhost:5432/secarena_db"

# Security Configuration
# WARNING: Change SECRET_KEY/JWT_SECRET_KEY in production! Generate using `openssl rand -hex 32`
SECRET_KEY="secarena-dev-secret-key-change-this-in-production-min-32-chars"
JWT_SECRET_KEY="secarena-dev-secret-key-change-this-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
